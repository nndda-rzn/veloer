{
  "name": "veloer",
  "version": "1.0.0",
  "description": "Veloer — Your Personal Cycling ERP. Track. Maintain. Ride.",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "lint": "npm run lint:client && npm run lint:server",
    "lint:client": "cd client && npm run lint",
    "lint:server": "cd server && npm run lint",
    "type-check": "npm run type-check:client && npm run type-check:server",
    "type-check:client": "cd client && tsc --noEmit",
    "type-check:server": "cd server && tsc --noEmit",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nndda-rzn/veloer.git"
  },
  "keywords": [
    "cycling",
    "erp",
    "strava",
    "bike",
    "tracking"
  ],
  "author": "Ananda Rizki <anandarizn@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nndda-rzn/veloer/issues"
  },
  "homepage": "https://github.com/nndda-rzn/veloer#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "standard-version": "^9.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
